---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactSection from "../components/ContactSection.astro";
import { contact } from "../data/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapQuery)}&output=embed`;
---

<Base
  title="Contact"
  description="Get in touch with our sales, leasing, investment and property management teams."
>
  <PageHeader
    crumb="Contact"
    eyebrow="Get in Touch"
    title="Tell us what you are planning."
    lede="Sales, leasing, investment or management — send the brief through and the right person will respond."
    image="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=2000&q=80"
  />

  <ContactSection />

  {/* Map */}
  <section class="border-t border-white/10 bg-ink-950">
    <div class="relative h-[420px] w-full md:h-[520px]">
      <iframe
        title="Office location map"
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-full w-full border-0 grayscale-[0.85] contrast-[1.1]"
      ></iframe>

      {/* Floating address card */}
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 p-5 md:inset-y-0 md:right-auto md:left-0 md:flex md:items-center md:p-10"
      >
        <div class="pointer-events-auto max-w-sm border-l-2 border-brand-600 bg-ink-900/95 p-7 backdrop-blur-md">
          <h2 class="font-display text-lg font-semibold tracking-tight text-bone-50">
            Visit the Office
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-mute-300">
            {contact.addressLines.map((l) => <span class="block">{l}</span>)}
          </p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.mapQuery)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="link-line mt-6 text-brand-500"
          >
            Open in Maps
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
