---
import { services } from "../data/site";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? services.slice(0, limit) : services;
---

<section id="services" class="relative overflow-hidden bg-ink-900 py-24 md:py-32">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionHead
        eyebrow="What We Do"
        title="Full-lifecycle capability, held in one team."
        lede="Six disciplines that let us take an asset from raw land to a stabilised, income-producing property — and keep it there."
        class="max-w-2xl"
      />
      <a href="/services" class="link-line mb-2 text-bone-50" data-reveal>
        All Services
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-16 grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Rows */}
      <div class="lg:col-span-7" id="svc-rows">
        <div class="border-t border-white/10">
          {
            list.map((service, i) => (
              <a
                href={`/services#${service.id}`}
                class="svc-row group relative block border-b border-white/10 py-8 transition-colors duration-500"
                data-index={i}
                data-reveal
                style={`--reveal-delay:${i * 70}ms`}
              >
                {/* Crimson wash that wipes in from the left on hover */}
                <span
                  aria-hidden="true"
                  class="absolute inset-y-0 -left-5 -z-0 w-[calc(100%+2.5rem)] origin-left scale-x-0 bg-white/[0.03] transition-transform duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100"
                />
                <span
                  aria-hidden="true"
                  class="absolute top-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-brand-600 transition-transform duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100"
                />

                <div class="relative flex items-start gap-5 md:gap-8">
                  <span class="mt-1.5 font-display text-[0.6875rem] font-semibold tracking-[0.18em] text-mute-500 tnum transition-colors duration-500 group-hover:text-brand-500">
                    {String(i + 1).padStart(2, "0")}
                  </span>

                  <div class="min-w-0 flex-1">
                    <h3 class="font-display text-2xl font-semibold tracking-tight text-bone-50 transition-transform duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] md:text-[1.75rem] lg:group-hover:translate-x-2">
                      {service.title}
                    </h3>
                    <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-mute-300">
                      {service.summary}
                    </p>

                    {/* Inline image for small screens, where the preview panel is hidden */}
                    <div class="frame frame--zoom mt-5 aspect-16/9 w-full lg:hidden">
                      <img src={service.image} alt="" loading="lazy" decoding="async" />
                    </div>
                  </div>

                  <span class="mt-1 flex h-9 w-9 flex-none items-center justify-center border border-white/12 text-mute-300 transition-all duration-500 group-hover:border-brand-600 group-hover:bg-brand-600 group-hover:text-white">
                    <Icon name="arrow-up-right" class="h-4 w-4" />
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      {/* Preview panel — desktop only, cross-fades with the hovered row */}
      <div class="hidden lg:col-span-5 lg:block">
        <div class="sticky top-32">
          <div class="frame aspect-4/5 w-full" data-reveal style="--reveal-delay:120ms">
            {
              list.map((service, i) => (
                <img
                  src={service.image}
                  alt={service.title}
                  loading="lazy"
                  decoding="async"
                  data-preview={i}
                  class:list={[
                    "absolute inset-0 h-full w-full object-cover transition-[opacity,transform] duration-800 ease-[cubic-bezier(0.16,1,0.3,1)]",
                    i === 0 ? "opacity-100" : "scale-105 opacity-0",
                  ]}
                />
              ))
            }
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/75 via-transparent to-transparent" />

            <div class="absolute inset-x-0 bottom-0 p-7">
              <div class="h-[2px] w-12 bg-brand-600"></div>
              <p
                id="svc-preview-label"
                class="mt-4 font-display text-lg font-semibold tracking-tight text-bone-50"
              >
                {list[0].title}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setup() {
    const rows = document.querySelectorAll<HTMLElement>("#svc-rows .svc-row");
    if (!rows.length) return;

    const previews = document.querySelectorAll<HTMLImageElement>("[data-preview]");
    const label = document.getElementById("svc-preview-label");

    const show = (index: number, title: string) => {
      previews.forEach((img) => {
        const active = img.dataset.preview === String(index);
        img.classList.toggle("opacity-100", active);
        img.classList.toggle("opacity-0", !active);
        img.classList.toggle("scale-105", !active);
      });
      if (label) label.textContent = title;
    };

    rows.forEach((row) => {
      const activate = () => {
        const title = row.querySelector("h3")?.textContent?.trim() ?? "";
        show(Number(row.dataset.index), title);
      };
      row.addEventListener("mouseenter", activate);
      row.addEventListener("focusin", activate);
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
