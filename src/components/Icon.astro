  instagram:
    '<path d="M12 2c2.7 0 3 0 4.1.06 1.1.05 1.8.22 2.4.47.7.26 1.2.6 1.7 1.16.56.55.9 1.06 1.16 1.7.25.6.42 1.3.47 2.4C22 9 22 9.3 22 12s0 3-.06 4.1c-.05 1.1-.22 1.8-.47 2.4a4.7 4.7 0 0 1-1.16 1.7c-.55.56-1.06.9-1.7 1.16-.6.25-1.3.42-2.4.47C15 22 14.7 22 12 22s-3 0-4.1-.06c-1.1-.05-1.8-.22-2.4-.47a4.7 4.7 0 0 1-1.7-1.16 4.7 4.7 0 0 1-1.16-1.7c-.25-.6-.42-1.3-.47-2.4C2 15 2 14.7 2 12s0-3 .06-4.1c.05-1.1.22-1.8.47-2.4.26-.7.6-1.2 1.16-1.7.55-.56 1.06-.9 1.7-1.16.6-.25 1.3-.42 2.4-.47C9 2 9.3 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4ZM17.2 5.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z"/>',
  x: '<path d="M17.7 3h3.3l-7.2 8.3L22 21h-6.6l-5.2-6.7L4.3 21H1l7.7-8.9L1.8 3h6.8l4.7 6.2L17.7 3Zm-1.2 16h1.8L7.6 4.8H5.7L16.5 19Z"/>',
