---
interface Props {
  name:
    | "arrow-right"
    | "arrow-up-right"
    | "phone"
    | "mail"
    | "pin"
    | "clock"
    | "check"
    | "plus"
    | "linkedin"
    | "instagram"
    | "x"
    | "whatsapp"
    | "chevron-down";
  class?: string;
}

const { name, class: klass = "h-4 w-4" } = Astro.props;

const paths: Record<string, string> = {
  "arrow-right": '<path d="M4 12h16m0 0-6-6m6 6-6 6"/>',
  "arrow-up-right": '<path d="M7 17 17 7m0 0H8m9 0v9"/>',
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.8.6 2.8.7a2 2 0 0 1 1.7 2.1Z"/>',
  mail: '<path d="M4 4h16v16H4z"/><path d="m4 6 8 6 8-6"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  check: '<path d="m4 12 5 5L20 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  "chevron-down": '<path d="m6 9 6 6 6-6"/>',
