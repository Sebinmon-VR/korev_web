};

const isFilled = name in filled;
---

{
  isFilled ? (
    <svg
      class={klass}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      set:html={filled[name]}
    />
  ) : (
    <svg
      class={klass}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="square"
      stroke-linejoin="miter"
      aria-hidden="true"
      set:html={paths[name]}
    />
  )
}
