---
import { company, contact, nav, services } from "../data/site";
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer
  transition:name="site-footer"
  class="relative overflow-hidden border-t border-white/10 bg-ink-950"
>
  {/* Oversized wordmark bleeding off the bottom edge */}
  <div
    aria-hidden="true"
    data-parallax="-46"
    class="pointer-events-none absolute -bottom-6 left-1/2 w-full max-w-[1400px] -translate-x-1/2 px-6 select-none md:-bottom-14"
  >
    <span
      class="block font-display text-[18vw] leading-none font-bold tracking-[-0.05em] text-white/[0.028] uppercase"
    >
      {company.markPrimary}
    </span>
  </div>

  <div class="shell relative py-20 md:py-24">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      {/* Brand */}
      <div class="lg:col-span-4">
        <Wordmark size="md" />
        <p class="mt-7 max-w-sm text-sm leading-relaxed text-mute-300">
          {company.seoDescription}
        </p>
        <div class="mt-8 flex gap-3">
          {
            contact.socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="flex h-10 w-10 items-center justify-center border border-white/12 text-mute-300 transition-all duration-400 hover:border-brand-600 hover:bg-brand-600 hover:text-white"
              >
                <Icon name={s.icon as any} class="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>

      {/* Navigate */}
      <div class="lg:col-span-2">
        <h3 class="font-display text-[0.6875rem] font-semibold tracking-[0.22em] text-bone-50 uppercase">
          Navigate
        </h3>
        <ul class="mt-6 space-y-3.5">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-mute-300 transition-colors duration-300 hover:text-brand-500"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Services */}
      <div class="lg:col-span-3">
        <h3 class="font-display text-[0.6875rem] font-semibold tracking-[0.22em] text-bone-50 uppercase">
          Services
        </h3>
        <ul class="mt-6 space-y-3.5">
          {
            services.slice(0, 5).map((s) => (
              <li>
                <a
                  href={`/services#${s.id}`}
                  class="text-sm text-mute-300 transition-colors duration-300 hover:text-brand-500"
                >
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Contact */}
      <div class="lg:col-span-3">
        <h3 class="font-display text-[0.6875rem] font-semibold tracking-[0.22em] text-bone-50 uppercase">
          Get in Touch
        </h3>
        <ul class="mt-6 space-y-5 text-sm text-mute-300">
          <li class="flex gap-3.5">
            <Icon name="pin" class="mt-0.5 h-4 w-4 flex-none text-brand-500" />
            <span>
              {contact.addressLines.map((l) => <span class="block">{l}</span>)}
            </span>
          </li>
          <li class="flex gap-3.5">
            <Icon name="phone" class="mt-0.5 h-4 w-4 flex-none text-brand-500" />
            <a href={`tel:${contact.phoneHref}`} class="transition-colors hover:text-bone-50">
              {contact.phone}
            </a>
          </li>
          <li class="flex gap-3.5">
            <Icon name="mail" class="mt-0.5 h-4 w-4 flex-none text-brand-500" />
            <a href={`mailto:${contact.email}`} class="transition-colors hover:text-bone-50">
              {contact.email}
            </a>
          </li>
          <li class="flex gap-3.5">
            <Icon name="clock" class="mt-0.5 h-4 w-4 flex-none text-brand-500" />
            <span>
              {
                contact.hours.map((h) => (
                  <span class="block">
                    {h.days}: {h.time}
                  </span>
                ))
              }
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs text-mute-400 md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} {company.legalName}. All rights reserved.</p>
      <div class="flex gap-7">
        <a href="#" class="transition-colors hover:text-bone-100">Privacy Policy</a>
        <a href="#" class="transition-colors hover:text-bone-100">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>
