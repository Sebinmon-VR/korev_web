---
import { closingCta, contact } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="relative overflow-hidden bg-bone-100 py-24 text-ink-900 md:py-28">
  {/* Diagonal crimson line sweeping the panel */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -right-40 h-[38rem] w-[38rem] rotate-45 border-t-[3px] border-brand-600/25"
  >
  </div>

  <div class="shell relative">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class="h-[2px] w-20 origin-left bg-brand-600" data-reveal-line></div>
        <h2 class="display-md mt-8 text-ink-900" data-reveal style="--reveal-delay:80ms">
          {closingCta.title}
        </h2>
        <p class="lede lede--dark mt-6 max-w-xl" data-reveal style="--reveal-delay:160ms">
          {closingCta.body}
        </p>
      </div>

      <div class="lg:col-span-5">
        <div
          class="flex flex-col gap-4 border-l-2 border-brand-600 pl-8"
          data-reveal
          style="--reveal-delay:220ms"
        >
          <a href={closingCta.primary.href} class="btn btn-primary w-full sm:w-auto">
            {closingCta.primary.label}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href={closingCta.secondary.href} class="btn btn-dark w-full sm:w-auto">
            {closingCta.secondary.label}
          </a>

          <a
            href={`tel:${contact.phoneHref}`}
            class="mt-4 flex items-center gap-3 font-display text-lg font-semibold tracking-tight text-ink-900 transition-colors hover:text-brand-600"
          >
            <Icon name="phone" class="h-4 w-4 text-brand-600" />
            {contact.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
