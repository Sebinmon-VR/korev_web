---
import { projects, projectFilters } from "../data/site";
import SectionHead from "./SectionHead.astro";
import ProjectCard from "./ProjectCard.astro";
import Icon from "./Icon.astro";

interface Props {
  /** Home page shows featured only and hides the filter bar */
  featuredOnly?: boolean;
  showFilters?: boolean;
  tone?: "light" | "dark";
}

const { featuredOnly = false, showFilters = true, tone = "dark" } = Astro.props;

const list = featuredOnly ? projects.filter((p) => p.featured) : projects;
const onBone = tone === "light";
---

<section
  id="projects"
  class:list={["relative py-24 md:py-32", onBone ? "bg-bone-100 text-ink-900" : "bg-ink-850"]}
>
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionHead
        eyebrow="Our Portfolio"
        title="Assets we have delivered and hold."
        lede="Residential, commercial and mixed-use developments across the Emirates — built, leased and managed by the same team."
        tone={onBone ? "dark" : "light"}
        class="max-w-2xl"
      />

      {
        featuredOnly && (
          <a
            href="/projects"
            class:list={["link-line mb-2", onBone ? "text-ink-900" : "text-bone-50"]}
            data-reveal
          >
            All Projects
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        )
      }
    </div>

    {/* Filter bar */}
    {
      showFilters && (
        <div
          class:list={[
            "mt-12 flex flex-wrap gap-2 border-b pb-5",
            onBone ? "border-ink-900/12" : "border-white/10",
          ]}
          id="project-filters"
          data-reveal
        >
          {projectFilters.map((filter, i) => (
            <button
              type="button"
              data-filter={filter}
              aria-pressed={i === 0 ? "true" : "false"}
              class:list={[
                "filter-btn px-5 py-2.5 font-display text-[0.6875rem] font-semibold tracking-[0.16em] uppercase transition-all duration-400",
                onBone
                  ? "text-mute-500 hover:text-ink-900"
                  : "text-mute-300 hover:text-bone-50",
              ]}
            >
              {filter}
            </button>
          ))}
        </div>
      )
    }

    <div
      id="project-grid"
      class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7"
    >
      {list.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>

    <p
      id="project-empty"
      class:list={[
        "hidden py-16 text-center font-display text-sm tracking-[0.12em] uppercase",
        onBone ? "text-mute-500" : "text-mute-400",
      ]}
    >
      No projects in this category yet.
    </p>
  </div>
</section>

<style>
  .filter-btn[aria-pressed="true"] {
    background: var(--color-brand-600);
    color: #fff;
  }
  .project-card.is-hidden {
    display: none;
  }
</style>

<script>
  function setup() {
    const bar = document.getElementById("project-filters");
    if (!bar) return;

    const buttons = bar.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>("#project-grid .project-card");
    const empty = document.getElementById("project-empty");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "All";

        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));

        let visible = 0;
        cards.forEach((card) => {
          const match = filter === "All" || card.dataset.category === filter;
          card.classList.toggle("is-hidden", !match);
          if (match) visible += 1;
        });

        empty?.classList.toggle("hidden", visible > 0);
      });
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
