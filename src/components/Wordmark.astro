---
import { company } from "../data/site";

interface Props {
  /** "light" sits on dark backgrounds, "dark" on bone/white */
  tone?: "light" | "dark";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { tone = "light", size = "md", class: klass = "" } = Astro.props;

const sizes = {
  sm: { primary: "text-base", secondary: "text-[0.5rem]", bar: "h-7" },
  md: { primary: "text-xl md:text-[1.375rem]", secondary: "text-[0.5625rem]", bar: "h-9" },
  lg: { primary: "text-3xl md:text-4xl", secondary: "text-[0.6875rem]", bar: "h-14" },
};
const s = sizes[size];
---

<a
  href="/"
  class={`group inline-flex items-center gap-3 ${klass}`}
  aria-label={`${company.legalName} — home`}
>
  {/* The red line: the brand device, drawn as a vertical bar */}
  <span
    class={`${s.bar} w-[3px] flex-none bg-brand-600 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:bg-brand-400`}
  ></span>

  <span class="flex flex-col leading-none">
    <span
      class={`font-display font-bold uppercase tracking-[0.02em] ${s.primary} ${
        tone === "light" ? "text-bone-50" : "text-ink-900"
      }`}
    >
      {company.markPrimary}
    </span>
    <span
      class={`font-display font-medium uppercase tracking-[0.28em] ${s.secondary} mt-1 ${
        tone === "light" ? "text-mute-300" : "text-mute-500"
      }`}
    >
      {company.markSecondary}
    </span>
  </span>
</a>
