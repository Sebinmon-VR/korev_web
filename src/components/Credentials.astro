---
import { credentials } from "../data/site";
---

<section class="border-y border-white/10 bg-ink-950 py-14">
  <div class="shell">
    <div class="flex flex-col gap-9 lg:flex-row lg:items-center lg:gap-14">
      <div class="lg:w-64 lg:flex-none">
        <span class="eyebrow" data-reveal>{credentials.eyebrow}</span>
      </div>

      {/* Placeholder marks — swap for real logo files when supplied */}
      <div class="grid flex-1 grid-cols-2 gap-px bg-white/8 sm:grid-cols-3 lg:grid-cols-6">
        {
          credentials.items.map((item, i) => (
            <div
              class="group flex min-h-20 items-center justify-center bg-ink-950 px-4 py-5 text-center"
              data-reveal
              style={`--reveal-delay:${i * 60}ms`}
            >
              <span class="font-display text-[0.6875rem] leading-tight font-semibold tracking-[0.14em] text-mute-400 uppercase transition-colors duration-500 group-hover:text-bone-100">
                {item}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
