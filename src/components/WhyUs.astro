---
import { whyUs } from "../data/site";
---

<section class="relative overflow-hidden bg-ink-900 py-24 md:py-32">
  {/* Faint vertical rules continuing the line motif */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden lg:block">
    <div class="shell h-full">
      <div class="grid h-full grid-cols-3">
        {[0, 1, 2].map(() => <div class="border-l border-white/[0.05]" />)}
      </div>
    </div>
  </div>

  <div class="shell relative">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      {/* Sticky heading + image */}
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <span class="eyebrow" data-reveal>{whyUs.eyebrow}</span>
          <h2 class="display-md mt-6 text-bone-50" data-reveal style="--reveal-delay:80ms">
            {whyUs.title}
          </h2>
          <p class="lede mt-6 max-w-md" data-reveal style="--reveal-delay:160ms">
            {whyUs.lede}
          </p>

          <div
            class="frame mt-10 hidden aspect-3/2 w-full lg:block"
            data-reveal="mask"
            style="--reveal-delay:240ms"
          >
            <img src={whyUs.image} alt={whyUs.imageAlt} loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-ink-950/25"></div>
          </div>
        </div>
      </div>

      {/* Numbered commitments */}
      <div class="lg:col-span-7">
        <div class="border-t border-white/10">
          {
            whyUs.items.map((item, i) => (
              <div
                class="group relative flex gap-6 border-b border-white/10 py-9 md:gap-10"
                data-reveal="right"
                style={`--reveal-delay:${i * 90}ms`}
              >
                {/* The red line grows down the left edge on hover */}
                <span
                  aria-hidden="true"
                  class="absolute top-0 -left-5 h-full w-[2px] origin-top scale-y-0 bg-brand-600 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-y-100"
                />

                <span class="font-display text-4xl font-bold tracking-tight text-white/10 tnum transition-colors duration-600 group-hover:text-brand-600 md:text-5xl">
                  {item.num}
                </span>

                <div class="pt-1">
                  <h3 class="font-display text-xl font-semibold tracking-tight text-bone-50 md:text-2xl">
                    {item.title}
                  </h3>
                  <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-mute-300">
                    {item.body}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
